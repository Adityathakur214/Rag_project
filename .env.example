# Copy this file to .env and fill in your real values.
# .env itself is git-ignored — never commit real keys.

CHAT_MODEL=gpt-5.6-luna
CHAT_API_KEY=your_real_api_key_here
CHAT_BASE_URL=https://api.experientiallabs.ai/v1
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# OPENAI_API_KEY=

# OPENAI_API_BASE_URL=https://api.experientiallabs.ai/v1

# EMBEDDING_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini


# Where raw source documents live, and where the Chroma index is persisted
DATA_DIR=data/raw
CHROMA_PERSIST_DIR=vectorstore/chroma_db

# Chunking config used by ingestion/splitter.py
CHUNK_SIZE=1000
CHUNK_OVERLAP=150